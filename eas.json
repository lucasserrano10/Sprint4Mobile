{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "withoutCredentials": false
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "ORG_GRADLE_PROJECT_android_kotlinVersion": "1.9.25"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ORG_GRADLE_PROJECT_android_kotlinVersion": "1.9.25"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
